{
  "name": "puntalink-pro-ts-struct",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "mocha --require tsx/cjs \"test/**/*.test.ts\"",
    "coverage": "nyc --extension .ts --reporter=lcov --reporter=text mocha --require tsx/cjs \"test/**/*.test.ts\"",
    "coverage:requirements": "node scripts/generate-test-coverage-report.js",
    "coverage:requirements:html": "node scripts/generate-requirements-html-report.js",
    "coverage:nyc": "nyc --extension .ts --reporter=lcov --reporter=text npm test",
    "test_nyc": "nyc --extension .ts --reporter=lcov --reporter=text mocha --require tsx/cjs"

  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^8.1.2",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "google-auth-library": "^10.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.13.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.13.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "@types/mocha": "^10.0.10",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.4",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "nyc": "^18.0.0",
    "supertest": "^7.2.2",
    "sinon": "^21.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
